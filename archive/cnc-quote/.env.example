# ---- Auth: "dev" (local only, no sign-in) or "entra" (Microsoft 365 sign-in)
AUTH_MODE=dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---- Quoting mailbox via Microsoft Graph (see docs/M365_SETUP.md)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=quotes@yourshop.com
GRAPH_WEBHOOK_URL=https://quote.yourshop.com/api/intake/graph/notify
GRAPH_CLIENT_STATE=change-me-to-a-random-string
# Which shop owns the mailbox: "entra:<tenant id>" in production, "dev:default" locally
INTAKE_TENANT_KEY=dev:default

# ---- Or a forwarding mailbox via IMAP
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ---- AI extraction (optional). Without a key the app uses deterministic extraction only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

RUN_JOBS_INLINE=false
CORS_ORIGINS=http://localhost:5173
