# Excel CNC pilot settings. Copy to .env on the server, then fill in the SECRET lines there.
# Never commit secrets to this repository.

# On Render these are entered in the dashboard instead (docs/RENDER_SETUP.md).

# ---- Sign-in: email accounts for everyone; Microsoft button optional
AUTH_MODE=prod
APP_URL=https://portal.excel-cnc.com
SIGNUP_OPEN=false
SIGNUP_DOMAINS=excel-cnc.com
ENTRA_TENANT_ID=782edd6a-46a8-416f-942f-d890b567234e
ENTRA_CLIENT_ID=195f4887-cb07-462a-bf97-ad0089629f4d
SMTP_HOST=smtp.resend.com
SMTP_USER=resend
SMTP_PASSWORD=                  # SECRET: email service API key
SMTP_FROM=CNC Quote <noreply@excel-cnc.com>

# ---- Quoting mailbox (Microsoft Graph)
GRAPH_TENANT_ID=782edd6a-46a8-416f-942f-d890b567234e
GRAPH_CLIENT_ID=02a1a3b2-f8ea-4f71-889e-89937d38902b
GRAPH_CLIENT_SECRET=            # SECRET: paste on the server only
GRAPH_MAILBOX=purchasing@excel-cnc.com
# purchasing@ also receives invoices and supplier mail: watch only the "RFQ" folder
# (create it in Outlook, top level or under Inbox, and fill it with a rule or by dragging RFQs in).
# Set GRAPH_FOLDER=inbox to watch the whole inbox with the RFQ filter only.
GRAPH_FOLDER=RFQ
INTAKE_FILTER=true
GRAPH_SHOP_DOMAINS=excel-cnc.com
GRAPH_CLIENT_STATE=             # SECRET: any long random string
INTAKE_TENANT_KEY=entra:782edd6a-46a8-416f-942f-d890b567234e

# Encrypts stored IMAP passwords. SECRET: long random value, never change it after mailboxes are added.
SECRET_KEY=

# ---- Optional AI extraction
ANTHROPIC_API_KEY=              # SECRET: optional

RUN_JOBS_INLINE=false
