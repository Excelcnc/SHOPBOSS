# ---- Auth: "dev" (local only, no sign-in) or "prod" (email + password accounts, plus optional
# "Sign in with Microsoft" when ENTRA_CLIENT_ID is set)
AUTH_MODE=dev
SIGNUP_OPEN=true
APP_URL=https://quote.yourshop.com
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# ---- Outgoing email for sign-up codes and invitations (any SMTP service)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Quoting mailbox via Microsoft Graph (see docs/M365_SETUP.md)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=quotes@yourshop.com
# Optional: defaults to APP_URL + /api/intake/graph/notify
GRAPH_WEBHOOK_URL=
# Only shops proven at these email domains may connect Microsoft 365 mailboxes (comma list)
GRAPH_SHOP_DOMAINS=yourshop.com
GRAPH_CLIENT_STATE=change-me-to-a-random-string
# Which shop owns the mailbox: "entra:<tenant id>" in production, "dev:default" locally
INTAKE_TENANT_KEY=dev:default

# ---- "Connect with Microsoft" for mailboxes (delegated sign-in, no PowerShell). Uses the GRAPH app
# above unless set; needs APP_URL and a Web redirect URI <APP_URL>/api/oauth/microsoft/callback.
MS_CONNECT_CLIENT_ID=
MS_CONNECT_CLIENT_SECRET=
MS_CONNECT_TENANT=

# ---- Or a forwarding mailbox via IMAP
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# ---- AI extraction (optional). Without a key the app uses deterministic extraction only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

SECRET_KEY=change-me-long-random
RUN_JOBS_INLINE=false
CORS_ORIGINS=http://localhost:5173

